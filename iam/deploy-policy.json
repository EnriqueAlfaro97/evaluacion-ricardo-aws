{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginEnECR",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EmpujarImagen",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:us-east-2:110212123540:repository/evaluacion-ricardo-app"
    },
    {
      "Sid": "LeerElCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:us-east-2:110212123540:cluster/evaluacion-ricardo"
    }
  ]
}
